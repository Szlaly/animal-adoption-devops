pipeline {
    agent any

    environment {
        BACKEND_DIR = "backend"
        FRONTEND_DIR = "frontend"
        APP_NAME_BACKEND = "animal-backend"
        APP_NAME_FRONTEND = "animal-frontend"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend Tests') {
            agent {
                docker { image 'node:20-alpine' }
            }
            steps {
                dir("${BACKEND_DIR}") {
                    sh 'npm install'
                    sh 'chmod +x ./node_modules/.bin/jest'
                    sh 'npm test'

                }
            }
        }

        stage('Frontend Tests') {
            agent {
                docker { image 'cypress/browsers:node20.10.0-chrome118'
                         args '-u 0:0' }
            }
            steps {
                dir("${FRONTEND_DIR}") {
                    sh 'npm install'
                    sh 'npm test -- --watch=false --browsers=ChromeHeadless'
                }
            }
        }

        stage('Backend Build') {
            agent {
                docker { image 'node:20-alpine' }
            }
            steps {
                dir("${BACKEND_DIR}") {
            sh 'npm install'
            sh 'chmod +x ./node_modules/.bin/tsc'
            sh './node_modules/.bin/tsc'
                }
            }
        }

        stage('Frontend Build') {
            agent {
                docker { image 'node:20-alpine' }
            }
            steps {
                dir("${FRONTEND_DIR}") {
            sh 'npm install'
            sh 'chmod +x ./node_modules/.bin/ng'
            sh './node_modules/.bin/ng build --configuration production'
                }
            }
        }

        stage('Docker Build Images') {
            steps {
                sh "docker build -t ${APP_NAME_BACKEND}:latest -f docker/Dockerfile.backend ."
                sh "docker build -t ${APP_NAME_FRONTEND}:latest -f docker/Dockerfile.frontend ."
            }
        }

     

    }
}
