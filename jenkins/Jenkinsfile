pipeline {
    agent any

    environment {
        BACKEND_DIR = "backend"
        FRONTEND_DIR = "frontend"
        APP_NAME_BACKEND = "animal-backend"
        APP_NAME_FRONTEND = "animal-frontend"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend Tests') {
            agent {
                docker { image 'node:20-alpine' }
            }
            steps {
                dir("${BACKEND_DIR}") {
                    sh 'npm install'
                    sh 'chmod +x ./node_modules/.bin/jest'
                    sh 'npm test'

                }
            }
        }

        stage('Frontend Tests') {
            agent {
                docker { image 'cypress/browsers:latest'
                         args '-u 0:0' }
            }
            steps {
                dir("${FRONTEND_DIR}") {
                    sh 'npm install'
                    sh 'npm test -- --watch=false --browsers=ChromeHeadlessNoSandbox'
                }
            }
        }

        stage('Backend Build') {
            agent {
                docker { image 'node:20-alpine' }
            }
            steps {
                dir("${BACKEND_DIR}") {
            sh 'npm install'
            sh 'chmod +x ./node_modules/.bin/tsc'
            sh './node_modules/.bin/tsc'
                }
            }
        }

        stage('Frontend Build') {
            agent {
                docker { image 'node:20-alpine' }
            }
            steps {
                dir("${FRONTEND_DIR}") {
            sh 'npm install'
            sh 'chmod +x ./node_modules/.bin/ng'
            sh './node_modules/.bin/ng build --configuration production'
                }
            }
        }

        stage('Docker Build Images') {
            steps {
                sh """
                    echo "Checking Docker network: shared-net..."
                    docker network inspect shared-net >/dev/null 2>&1 || docker network create shared-net
                    echo "Docker network ready."

                    docker build -t ${APP_NAME_BACKEND}:latest -f docker/Dockerfile.backend .
                    docker build -t ${APP_NAME_FRONTEND}:latest -f docker/Dockerfile.frontend .
                """
            }
        }
     
        stage('Deploy Services (Docker Compose)') {
            steps {
                sh "docker compose -f docker/docker-compose.yml up -d --build"
            }
        }

        stage('Deploy Monitoring & Logs') {
            steps {
                sh "docker compose -f docker/docker-compose.monitoring.yml up -d --build"
            }
        }
        stage('Deploy via Ansible') {
        steps {
            sh '''
            source /var/jenkins_home/venv/bin/activate
            ansible-playbook ansible/deploy.yml -i ansible/host.ini
            '''
        }
    }



    }

    post {
        always {
            echo "Pipeline finished."
        }
    
    }
}
